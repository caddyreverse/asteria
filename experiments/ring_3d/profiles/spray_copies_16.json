{
  "schema_version": 1,
  "name": "ring-3d-spray-copies-16",
  "parallelism": {
    "tp": 1,
    "pp": 1,
    "dp": 16
  },
  "steps": 4,
  "compute_duration_us": 0,
  "tp_all_reduce_bytes": 0,
